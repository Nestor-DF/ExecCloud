{
  "name": "filtro_mpi",
  "description": "Applies a grayscale filter to an image using MPI distributed parallelism with 4 processes.",
  "timeout": 120,
  "execution": {
    "wrapper": "mpirun",
    "wrapperArgs": ["-np", "4"]
  },
  "args": [
    {
      "id": "input_image",
      "label": "Input Image",
      "type": "file",
      "accept": "image/*"
    },
    {
      "id": "output_image",
      "label": "Output Image",
      "type": "output_file",
      "extension": ".png"
    }
  ]
}
